<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
    <PackageReference Include="CsvHelper" Version="34.1.0" />
    <PackageReference Include="Sep" Version="0.18.0" />
    <PackageReference Include="SoftCircuits.CsvParser" Version="4.6.0" />
    <PackageReference Include="Sylvan.Data.Csv" Version="1.4.4" />
    <PackageReference Include="TinyCsvParser" Version="3.0.13" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Remove="RealWorkloadWithCsv\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PocketCsvReader\PocketCsvReader.csproj" />
    <ProjectReference Include="..\PocketCsvReader.Indexing\PocketCsvReader.Indexing.csproj" />
    <ProjectReference Include="..\PocketCsvReader.Json\PocketCsvReader.Json.csproj" />
    <ProjectReference Include="..\PocketCsvReader.Ndjson\PocketCsvReader.Ndjson.csproj" />
    <ProjectReference Include="..\PocketCsvReader.FixedWidth\PocketCsvReader.FixedWidth.csproj" />
    <ProjectReference Include="..\PocketCsvReader.WebLogs\PocketCsvReader.WebLogs.csproj" />
    <ProjectReference Include="..\PocketCsvReader.KeyValue\PocketCsvReader.KeyValue.csproj" />
    <ProjectReference Include="..\PocketCsvReader.Chrononuensis\PocketCsvReader.Chrononuensis.csproj" />
    <ProjectReference Include="..\PocketCsvReader.Arrow.ColumnarJson\PocketCsvReader.Arrow.ColumnarJson.csproj" />
    <ProjectReference Include="..\PocketCsvReader.Arrow.NetCdf\PocketCsvReader.Arrow.NetCdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
